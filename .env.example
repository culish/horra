# Copy to .env.local (development) or set in your hosting dashboard (production).
# Leave a value empty until it has been verified — the site then shows "To be confirmed"
# and never renders a working link for it.

# Public site URL — used for canonical URLs, Open Graph, sitemap.xml and robots.txt
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Official contact details (verified only)
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
# WhatsApp number in international format, digits only, e.g. 62812xxxxxxx
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Office address, on one line
NEXT_PUBLIC_OFFICE_ADDRESS=
NEXT_PUBLIC_OFFICE_HOURS=

# Social profiles (full URLs). Only filled-in links are shown.
NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_YOUTUBE=

# Inquiry delivery (server-side only — never exposed to the browser).
# Any HTTPS endpoint that accepts a JSON POST: CRM webhook, Zapier/Make, Formspree, a mail function, etc.
# Without it, forms validate and then tell the visitor plainly that nothing was sent (demo mode).
INQUIRY_WEBHOOK_URL=
# Optional bearer token sent as "Authorization: Bearer <token>"
INQUIRY_WEBHOOK_TOKEN=

# ---------------------------------------------------------------------------------------------
# Online payments (Midtrans) — see README.md → Payments. Leave empty to keep payments switched off.
# Sandbox keys: dashboard.sandbox.midtrans.com → Settings → Access Keys.
MIDTRANS_SERVER_KEY=
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
# "true" only with production keys, once Midtrans has activated the account for live payments
MIDTRANS_IS_PRODUCTION=false
# Random secret (32+ characters) that signs payment links, e.g. `openssl rand -base64 48`.
# Changing it invalidates every link already sent.
PAYMENT_LINK_SECRET=
# Staff key for /pay/admin (12+ characters). Share only with staff who issue invoices.
PAYMENT_ADMIN_KEY=
# Where payment status updates are forwarded (JSON POST), like INQUIRY_WEBHOOK_URL
PAYMENT_WEBHOOK_URL=
PAYMENT_WEBHOOK_TOKEN=
